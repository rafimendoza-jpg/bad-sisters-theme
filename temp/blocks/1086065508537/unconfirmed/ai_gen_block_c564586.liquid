{% doc %}
  @prompt
    un diseño editorial estilo revista, que sea un carrusel, pero de fotos, no de productos ni colecciones sino que de imagenes con texto, puedes hacer que la imagen sea más pequeña y cuadradita
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__inner { width: 100%; margin: 0 auto; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__header { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 26px; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__heading { margin: 0; max-width: 760px; font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size: clamp(32px, 5vw, {{ block.settings.heading_size }}px); line-height: .98; letter-spacing: -.045em; font-weight: 400; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__intro { margin: 12px 0 0; max-width: 520px; font-size: 14px; line-height: 1.55; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__controls { display: flex; flex: 0 0 auto; gap: 8px; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__button { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 1px solid {{ block.settings.text_color }}; border-radius: 50%; background: transparent; color: {{ block.settings.text_color }}; cursor: pointer; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__button:hover { background: {{ block.settings.text_color }}; color: {{ block.settings.background_color }}; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__button:focus-visible, .ai-editorial-carousel-{{ ai_gen_id }} a:focus-visible { outline: 2px solid {{ block.settings.text_color }}; outline-offset: 4px; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__button svg { width: 18px; height: 18px; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__track { display: flex; gap: {{ block.settings.slide_gap }}px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; -ms-overflow-style: none; padding-bottom: 8px; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__track::-webkit-scrollbar { display: none; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__slide { position: relative; flex: 0 0 calc((100% - ({{ block.settings.desktop_slides | minus: 1 }} * {{ block.settings.slide_gap }}px)) / {{ block.settings.desktop_slides }}); min-width: 0; scroll-snap-align: start; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__image-wrap { position: relative; overflow: hidden; width: {{ block.settings.image_width }}%; margin: 0 auto; aspect-ratio: 1 / 1; background: #eee9e5; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__image-wrap img, .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__image-wrap svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__empty { position: absolute; inset: auto 0 0; display: flex; min-height: 58px; align-items: center; justify-content: center; padding: 12px; color: #4b4541; background: rgba(255,255,255,.9); text-align: center; font-size: 13px; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__caption { width: {{ block.settings.image_width }}%; margin: 0 auto; padding-top: 14px; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__eyebrow { margin: 0 0 7px; color: {{ block.settings.muted_color }}; font-size: 10px; line-height: 1.3; letter-spacing: .14em; text-transform: uppercase; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__title { margin: 0; font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size: {{ block.settings.card_title_size }}px; font-weight: 400; line-height: 1.15; letter-spacing: -.025em; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__text { margin: 8px 0 0; font-size: 13px; line-height: 1.55; }
  .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__link { display: inline-block; margin-top: 11px; color: inherit; font-size: 12px; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  @media screen and (max-width: 749px) {
    .ai-editorial-carousel-{{ ai_gen_id }} { padding: {{ block.settings.mobile_padding }}px 0; }
    .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__header { align-items: end; margin-bottom: 19px; }
    .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__heading { font-size: clamp(30px, 9vw, {{ block.settings.heading_size }}px); }
    .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__controls { gap: 6px; }
    .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__button { width: 38px; height: 38px; }
    .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__slide { flex-basis: {{ block.settings.mobile_slide_width }}%; }
    .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__image-wrap, .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__caption { width: {{ block.settings.mobile_image_width }}%; }
    .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__title { font-size: {{ block.settings.mobile_title_size }}px; }
  }
  @media (prefers-reduced-motion: reduce) { .ai-editorial-carousel-{{ ai_gen_id }} .ai-editorial-carousel__track { scroll-behavior: auto; } }
{% endstyle %}

<editorial-carousel-{{ ai_gen_id }} class="ai-editorial-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-carousel__inner">
    <div class="ai-editorial-carousel__header">
      <div>
        {% if block.settings.heading != blank %}<h2 class="ai-editorial-carousel__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
        {% if block.settings.intro != blank %}<p class="ai-editorial-carousel__intro">{{ block.settings.intro | escape }}</p>{% endif %}
      </div>
      <div class="ai-editorial-carousel__controls" aria-label="Controles del carrusel">
        <button class="ai-editorial-carousel__button" type="button" data-direction="previous" aria-label="Imagen anterior"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18 9 12l6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button class="ai-editorial-carousel__button" type="button" data-direction="next" aria-label="Imagen siguiente"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>
    <div class="ai-editorial-carousel__track" tabindex="0" aria-label="Carrusel de imágenes editoriales">
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign eyebrow_key = 'eyebrow_' | append: i
          assign title_key = 'title_' | append: i
          assign text_key = 'text_' | append: i
          assign link_key = 'link_' | append: i
          assign image = block.settings[image_key]
          assign eyebrow = block.settings[eyebrow_key]
          assign title = block.settings[title_key]
          assign text = block.settings[text_key]
          assign link = block.settings[link_key]
        %}
        <article class="ai-editorial-carousel__slide">
          <div class="ai-editorial-carousel__image-wrap">
            {% if image != blank %}
              {{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', alt: image.alt | escape }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-editorial-carousel__empty">Agrega una imagen para esta historia</div>
            {% endif %}
          </div>
          <div class="ai-editorial-carousel__caption">
            {% if eyebrow != blank %}<p class="ai-editorial-carousel__eyebrow">{{ eyebrow | escape }}</p>{% endif %}
            {% if title != blank %}<h3 class="ai-editorial-carousel__title">{{ title | escape }}</h3>{% endif %}
            {% if text != blank %}<p class="ai-editorial-carousel__text">{{ text | escape }}</p>{% endif %}
            {% if link != blank and block.settings.link_label != blank %}<a class="ai-editorial-carousel__link" href="{{ link }}">{{ block.settings.link_label | escape }}</a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</editorial-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'editorial-carousel-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class EditorialCarousel extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.ai-editorial-carousel__track');
        this.querySelectorAll('.ai-editorial-carousel__button').forEach((button) => {
          button.addEventListener('click', () => {
            const slide = this.track.querySelector('.ai-editorial-carousel__slide');
            if (!slide) return;
            const direction = button.dataset.direction === 'next' ? 1 : -1;
            const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
            this.track.scrollBy({ left: direction * (slide.getBoundingClientRect().width + gap), behavior: 'smooth' });
          });
        });
      }
    }
    customElements.define(tagName, EditorialCarousel);
  })();
</script>

{% schema %}
{
  "name": "Carrusel editorial",
  "settings": [
    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Historias en imágenes" },
    { "type": "textarea", "id": "intro", "label": "Introducción" },
    { "type": "range", "id": "desktop_width_percent", "label": "Ancho en escritorio", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "desktop_slides", "label": "Imágenes visibles en escritorio", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "mobile_slide_width", "label": "Ancho de tarjeta en móvil", "min": 65, "max": 95, "step": 5, "unit": "%", "default": 85 },
    { "type": "range", "id": "image_width", "label": "Tamaño de imagen en escritorio", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 75 },
    { "type": "range", "id": "mobile_image_width", "label": "Tamaño de imagen en móvil", "min": 60, "max": 100, "step": 5, "unit": "%", "default": 85 },
    { "type": "header", "content": "Diseño" },
    { "type": "font_picker", "id": "heading_font", "label": "Tipografía de títulos", "default": "helvetica_n3" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título principal", "min": 32, "max": 72, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "card_title_size", "label": "Tamaño de títulos", "min": 16, "max": 32, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "mobile_title_size", "label": "Títulos en móvil", "min": 16, "max": 28, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "slide_gap", "label": "Espacio entre imágenes", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "section_padding", "label": "Espacio vertical en escritorio", "min": 0, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_padding", "label": "Espacio vertical en móvil", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 25 },
    { "type": "color", "id": "background_color", "label": "Fondo", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#1a1a1a" },
    { "type": "color", "id": "muted_color", "label": "Texto secundario", "default": "#595959" },
    { "type": "header", "content": "Contenido de imágenes" },
    { "type": "image_picker", "id": "image_1", "label": "Imagen 1" },
    { "type": "text", "id": "eyebrow_1", "label": "Categoría 1" },
    { "type": "text", "id": "title_1", "label": "Título 1" },
    { "type": "textarea", "id": "text_1", "label": "Texto 1" },
    { "type": "url", "id": "link_1", "label": "Enlace 1" },
    { "type": "image_picker", "id": "image_2", "label": "Imagen 2" },
    { "type": "text", "id": "eyebrow_2", "label": "Categoría 2" },
    { "type": "text", "id": "title_2", "label": "Título 2" },
    { "type": "textarea", "id": "text_2", "label": "Texto 2" },
    { "type": "url", "id": "link_2", "label": "Enlace 2" },
    { "type": "image_picker", "id": "image_3", "label": "Imagen 3" },
    { "type": "text", "id": "eyebrow_3", "label": "Categoría 3" },
    { "type": "text", "id": "title_3", "label": "Título 3" },
    { "type": "textarea", "id": "text_3", "label": "Texto 3" },
    { "type": "url", "id": "link_3", "label": "Enlace 3" },
    { "type": "image_picker", "id": "image_4", "label": "Imagen 4" },
    { "type": "text", "id": "eyebrow_4", "label": "Categoría 4" },
    { "type": "text", "id": "title_4", "label": "Título 4" },
    { "type": "textarea", "id": "text_4", "label": "Texto 4" },
    { "type": "url", "id": "link_4", "label": "Enlace 4" },
    { "type": "image_picker", "id": "image_5", "label": "Imagen 5" },
    { "type": "text", "id": "eyebrow_5", "label": "Categoría 5" },
    { "type": "text", "id": "title_5", "label": "Título 5" },
    { "type": "textarea", "id": "text_5", "label": "Texto 5" },
    { "type": "url", "id": "link_5", "label": "Enlace 5" },
    { "type": "image_picker", "id": "image_6", "label": "Imagen 6" },
    { "type": "text", "id": "eyebrow_6", "label": "Categoría 6" },
    { "type": "text", "id": "title_6", "label": "Título 6" },
    { "type": "textarea", "id": "text_6", "label": "Texto 6" },
