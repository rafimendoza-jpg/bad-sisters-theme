{%- comment -%} Customer: Account — Portal BSD {%- endcomment -%}

<section class="section-padding">
  <div class="page-width">

    {%- comment -%} Account Header {%- endcomment -%}
    <div class="account-header">
      <div class="account-header__welcome">
        <div class="account-header__avatar">
          {{ customer.first_name | slice: 0 | upcase }}{{ customer.last_name | slice: 0 | upcase }}
        </div>
        <div>
          <h1 class="account-header__name">Hola, {{ customer.first_name }}</h1>
          <p class="account-header__email">{{ customer.email }}</p>
        </div>
      </div>
      <a href="/account/logout" class="btn btn--secondary btn--small">Cerrar sesión</a>
    </div>

    {%- comment -%} Dashboard Grid {%- endcomment -%}
    <div class="account-grid">

      {%- comment -%} Order History {%- endcomment -%}
      <div class="account-card">
        <h2 class="account-card__title">Historial de pedidos</h2>

        {%- if customer.orders.size > 0 -%}
          <div class="account-table-wrap">
            <table class="account-table">
              <thead>
                <tr>
                  <th>Pedido</th>
                  <th>Fecha</th>
                  <th>Estado</th>
                  <th style="text-align: right;">Total</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  {%- comment -%} Smart status: prioritise payment status over fulfillment {%- endcomment -%}
                  {%- assign _bsd_status_label = 'Pendiente' -%}
                  {%- assign _bsd_status_class = 'pending' -%}

                  {%- if order.financial_status == 'paid' or order.financial_status == 'partially_paid' -%}
                    {%- if order.fulfillment_status == 'fulfilled' -%}
                      {%- assign _bsd_status_label = 'Enviado' -%}
                      {%- assign _bsd_status_class = 'fulfilled' -%}
                    {%- elsif order.fulfillment_status == 'partial' -%}
                      {%- assign _bsd_status_label = 'Envío parcial' -%}
                      {%- assign _bsd_status_class = 'partial' -%}
                    {%- else -%}
                      {%- assign _bsd_status_label = 'Pagado' -%}
                      {%- assign _bsd_status_class = 'paid' -%}
                    {%- endif -%}
                  {%- elsif order.financial_status == 'refunded' -%}
                    {%- assign _bsd_status_label = 'Devuelto' -%}
                    {%- assign _bsd_status_class = 'refunded' -%}
                  {%- elsif order.financial_status == 'partially_refunded' -%}
                    {%- assign _bsd_status_label = 'Reembolso parcial' -%}
                    {%- assign _bsd_status_class = 'partial' -%}
                  {%- elsif order.financial_status == 'voided' or order.cancelled -%}
                    {%- assign _bsd_status_label = 'Cancelado' -%}
                    {%- assign _bsd_status_class = 'refunded' -%}
                  {%- elsif order.financial_status == 'pending' or order.financial_status == 'authorized' -%}
                    {%- assign _bsd_status_label = 'Pago pendiente' -%}
                    {%- assign _bsd_status_class = 'pending' -%}
                  {%- endif -%}

                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                    <td>
                      <span class="account-badge account-badge--{{ _bsd_status_class }}">
                        {{ _bsd_status_label }}
                      </span>
                    </td>
                    <td style="text-align: right; font-weight: 500;">{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- else -%}
          <p class="account-card__empty">No tienes pedidos aún.</p>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} Address {%- endcomment -%}
    <div class="account-card" style="margin-top: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <h2 class="account-card__title" style="margin-bottom: 0;">Dirección predeterminada</h2>
        <a href="/account/addresses" class="btn btn--secondary btn--small">Gestionar direcciones</a>
      </div>
      {%- if customer.default_address -%}
        <div style="margin-top: 1rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: var(--border-radius);">
          <p style="font-weight: 500;">{{ customer.default_address.name }}</p>
          <p style="color: var(--color-text-light); font-size: 0.9rem; margin-top: 0.35rem;">
            {{ customer.default_address | format_address }}
          </p>
        </div>
      {%- else -%}
        <p class="account-card__empty" style="margin-top: 1rem;">No tienes direcciones guardadas.</p>
      {%- endif -%}
    </div>

    {%- comment -%} ===== WISHLIST / FAVORITOS ===== {%- endcomment -%}
    <div class="account-card account-wishlist-card" style="margin-top: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
        <h2 class="account-card__title" style="margin-bottom: 0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          Mis Favoritos
          <span class="account-wishlist__count" data-wishlist-total>0</span>
        </h2>
      </div>

      <div class="wishlist-grid" data-wishlist-grid></div>

      <p class="account-card__empty account-wishlist__empty" data-wishlist-empty style="display:none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="vertical-align: -4px; margin-right: 4px; opacity: .5;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        Aún no tienes productos en favoritos. Explora nuestra <a href="/collections/all">tienda</a> y guarda los que más te gusten.
      </p>
    </div>

    {%- comment -%} ===== PRODUCTOS PENDIENTES DE RESEÑA ===== {%- endcomment -%}
    {%- if customer.orders.size > 0 -%}
      <div class="account-card account-reviews-card" style="margin-top: 2rem;">
        <h2 class="account-card__title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -3px; margin-right: 4px;"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Deja tu reseña
        </h2>
        <div class="account-reviews-card__incentive">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span>¡Tu opinión nos ayuda a mejorar y a otras Bad Girls a decidir!</span>
        </div>

        {%- assign bsd_review_seen = '' -%}
        <div class="account-reviews__list">
          {%- for order in customer.orders -%}
            {%- for line_item in order.line_items -%}
              {%- assign pid_str = line_item.product_id | append: '' -%}
              {%- unless bsd_review_seen contains pid_str -%}
                {%- assign bsd_review_seen = bsd_review_seen | append: pid_str | append: ',' -%}

                {%- comment -%} Build product URL — fallback to unavailable page {%- endcomment -%}
                {%- assign _prod_url = '' -%}
                {%- assign _prod_available = false -%}
                {%- if line_item.product.handle != blank -%}
                  {%- assign _prod_url = '/products/' | append: line_item.product.handle -%}
                  {%- if line_item.product.published_at != blank -%}
                    {%- assign _prod_available = true -%}
                  {%- endif -%}
                {%- endif -%}
                {%- unless _prod_available -%}
                  {%- assign _prod_url = '/pages/producto-no-disponible' -%}
                {%- endunless -%}

                <div class="account-review-item">
                  <div class="account-review-item__media">
                    {%- if line_item.image -%}
                      <img src="{{ line_item.image | image_url: width: 200 }}" alt="{{ line_item.product.title | default: line_item.title | escape }}" loading="lazy" width="80" height="80">
                    {%- elsif line_item.product.featured_image -%}
                      <img src="{{ line_item.product.featured_image | image_url: width: 200 }}" alt="{{ line_item.product.title | escape }}" loading="lazy" width="80" height="80">
                    {%- else -%}
                      <div class="account-review-item__placeholder">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="account-review-item__info">
                    <a href="{{ _prod_url }}" class="account-review-item__title">{{ line_item.product.title | default: line_item.title }}</a>
                    <span class="account-review-item__order">Pedido {{ order.name }} · {{ order.created_at | date: '%d/%m/%Y' }}</span>
                  </div>
                  <div class="account-review-item__actions">
                    {%- if _prod_available -%}
                      <a href="{{ _prod_url }}#junip-product-review-widget" class="account-review-item__btn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        Dejar reseña
                      </a>
                    {%- else -%}
                      <span class="account-review-item__btn" style="opacity: 0.4; cursor: default; pointer-events: none;">
                        No disponible
                      </span>
                    {%- endif -%}
                  </div>
                </div>
              {%- endunless -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  /* Account Header */
  .account-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .account-header__welcome {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .account-header__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .account-header__name {
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0;
  }
  .account-header__email {
    font-size: 0.85rem;
    color: var(--color-text-light);
    margin: 0.15rem 0 0;
  }

  /* Points Summary Card */
  .account-points-card {
    background: var(--color-text);
    color: var(--color-background);
    border-radius: var(--border-radius);
    padding: 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }
  .account-points-card__label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.5rem;
  }
  .account-points-card__value {
    display: block;
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 300;
    line-height: 1;
  }
  .account-points-card__sub {
    display: block;
    font-size: 0.85rem;
    opacity: 0.6;
    margin-top: 0.25rem;
  }
  .account-points-card__hint {
    display: block;
    font-size: 0.78rem;
    opacity: 0.5;
    margin-top: 0.35rem;
    font-style: italic;
  }
  .account-points-card__info {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255,255,255,0.15);
    font-size: 0.78rem;
    opacity: 0.65;
  }

  /* Dashboard Grid */
  .account-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 768px) {
    .account-grid { grid-template-columns: 1fr; }
  }

  /* Account Card */
  .account-card {
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: 1.5rem;
  }
  .account-card__title {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .account-card__empty {
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  /* Account Table */
  .account-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .account-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .account-table th {
    text-align: left;
    padding: 0.6rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-light);
  }
  .account-table td {
    padding: 0.6rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }
  .account-table tbody tr:hover { background: rgba(0,0,0,0.015); }
  .account-table tfoot td {
    border-bottom: none;
    border-top: 2px solid var(--color-text);
    padding-top: 0.75rem;
  }
  .account-table a {
    color: var(--color-accent);
    font-weight: 500;
  }
  .account-table a:hover { text-decoration: underline; }

  /* Status badges */
  .account-badge {
    display: inline-block;
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 20px;
    font-weight: 500;
    text-transform: capitalize;
  }
  .account-badge--paid { background: #e8f5e9; color: #2e7d32; }
  .account-badge--fulfilled { background: #e0f2f1; color: #00695c; }
  .account-badge--pending { background: #fff3e0; color: #e65100; }
  .account-badge--partial { background: #e3f2fd; color: #1565c0; }
  .account-badge--refunded { background: #fce4ec; color: #c62828; }

  .account-referral__share.is-copied {
    background: #2e7d32;
  }

  /* ====== REVIEWS PENDING SECTION ====== */
  .account-reviews-card__incentive {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: #fef9e7;
    border: 1px solid #f5d67b;
    border-radius: calc(var(--border-radius) / 2);
    padding: 0.85rem 1rem;
    margin: -0.5rem 0 1.5rem;
    font-size: 0.82rem;
    color: #7a5c00;
    line-height: 1.5;
  }
  .account-reviews-card__incentive svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: #d4a000;
  }
  .account-reviews-card__incentive strong {
    color: #5a4200;
  }

  .account-reviews__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .account-review-item {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .account-review-item:last-child { border-bottom: none; }
  .account-review-item__media {
    width: 80px;
    height: 80px;
    border-radius: calc(var(--border-radius) / 2);
    overflow: hidden;
    background: #f5f5f5;
    flex-shrink: 0;
  }
  .account-review-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .account-review-item__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .account-review-item__info { min-width: 0; }
  .account-review-item__title {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.3;
    text-decoration: none;
  }
  .account-review-item__title:hover { color: var(--color-accent); }
  .account-review-item__order {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-light);
    margin-top: 0.2rem;
  }
  .account-review-item__actions { flex-shrink: 0; }
  .account-review-item__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--color-text);
    border-radius: var(--button-border-radius);
    background: transparent;
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .account-review-item__btn:hover {
    background: var(--color-text);
    color: var(--color-background);
  }
  @media (max-width: 600px) {
    .account-review-item {
      grid-template-columns: 60px 1fr;
      gap: 0.75rem;
    }
    .account-review-item__media { width: 60px; height: 60px; }
    .account-review-item__actions { grid-column: 1 / -1; }
  }
</style>


